# Copy to .env and fill in. Never commit .env (it holds LINE secrets).
#   copy .env.example .env      (Windows)   |   cp .env.example .env   (macOS/Linux)

# --- LINE Messaging API (optional: leave empty to use only the /api/sim/* simulator) ---
# LINE Developers console > your channel > Basic settings > Channel secret
LINE_CHANNEL_SECRET=
# Messaging API tab > Channel access token (long-lived)
LINE_CHANNEL_TOKEN=

# --- Team API ---
# Shared secret sent as header "X-Team-Token" (needed when TEAM_AUTH=on, and for /api/admin/* and /api/sim/*
# on an instance with LINE or DATABASE_URL). Empty there = those endpoints are disabled.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TEAM_TOKEN=

# --- Team board login ---
# off (default): /board opens without a code, so evaluators can look at it straight away. Anyone with the link can
#   see learner data and change help requests, so keep real learner data out of it.
# on: /board asks for the team code (TEAM_TOKEN below) and every team endpoint needs it.
# Whatever this says, /api/admin/* and /api/sim/* need TEAM_TOKEN on an instance with a LINE token or DATABASE_URL.
TEAM_AUTH=off

# --- Storage ---
# Supabase Postgres: Dashboard > Connect > "Session pooler" URI (IPv4, works on Render). Contains the DB
# password, so keep it only here and in the Render dashboard. Empty = SQLite file below.
DATABASE_URL=
# Tests only: runs the same test suite against Postgres in a throwaway schema "tiis_test" (never `public`)
TEST_DATABASE_URL=
# SQLite file path
DB_PATH=data.db

# --- Project timeline ---
# Day 1 of the 6-week pilot (YYYY-MM-DD). Placeholder: set the real start date.
PROJECT_START=2026-10-19
# Demo only: pretend today is this date (e.g. to try the week 5-6 follow-up). Leave empty normally.
DEMO_TODAY=
